# Featherless AI — https://featherless.ai
# Copy this file to `backend/.env` and paste your real key there.
# `.env` is gitignored; NEVER commit a real key.
FEATHERLESS_API_KEY=your_featherless_api_key_here

# Optional overrides (defaults shown)
# FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_MAX_TOKENS=400
# FEATHERLESS_TEMPERATURE=0.3
# FEATHERLESS_TIMEOUT_MS=25000
# PORT=8787

# Camera vision — frames go to a vision model, which describes the scene for the
# (text-only) guidance model above. Tested: the 72B reads frames correctly; the 32B
# gave wrong answers on a control image, so re-test before swapping it for speed.
# FEATHERLESS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# FEATHERLESS_VISION_MAX_TOKENS=160
# FEATHERLESS_VISION_TIMEOUT_MS=15000
# VISION_ENABLED=true
