{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },

  "rewrites": [
    { "source": "/site", "destination": "/apps/site/index.html" },
    { "source": "/site/", "destination": "/apps/site/index.html" },
    { "source": "/site/:path*", "destination": "/apps/site/:path*" },

    { "source": "/", "destination": "/apps/web/index.html" },
    { "source": "/:path*", "destination": "/apps/web/:path*" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self)"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
